                339
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "The AX Agent provides automated monitoring reports, in-depth analysis, and improvement guidance based on monitoring data. Jira and email integration supports issue follow-up and progress tracking \n",
