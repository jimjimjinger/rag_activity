                447,
                446
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "The dashboard automates crawling-based data collection, quality monitoring, score calculation, and reportinq, reducing repetitive manual work ",
